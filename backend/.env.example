# EarthPulse AI - Backend Environment Template
ENVIRONMENT=development
PROJECT_NAME="EarthPulse AI Backend"
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://earthpulse:earthpulse_dev_password@localhost:5432/earthpulse_db

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Remote Sensing API Base URLs
NASA_POWER_API_BASE=https://power.larc.nasa.gov/api/temporal
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Reasoning / LLM Configuration (Optional)
OPENAI_API_KEY=
GROQ_API_KEY=
