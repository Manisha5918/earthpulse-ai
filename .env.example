# ==============================================================================
# EarthPulse AI - Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for local development or production.

# Application Environment (development | staging | production)
ENVIRONMENT=development
PROJECT_NAME="EarthPulse AI"
DEBUG=true

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://earthpulse:earthpulse_dev_password@localhost:5432/earthpulse_db
POSTGRES_USER=earthpulse
POSTGRES_PASSWORD=earthpulse_dev_password
POSTGRES_DB=earthpulse_db
POSTGRES_PORT=5432

# Supabase (Auth and Remote Database Hosting)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Remote Sensing & Data Sources
NASA_POWER_API_BASE=https://power.larc.nasa.gov/api/temporal
COPERNICUS_CLIENT_ID=your_copernicus_id_if_using_dataspace
COPERNICUS_CLIENT_SECRET=your_copernicus_secret_if_using_dataspace
PLANETARY_COMPUTER_API_KEY=optional_planetary_computer_key
NOAA_CLASS_KEY=optional_viirs_key

# AI / Reasoning Engine
OPENAI_API_KEY=optional_openai_key_for_llm_explanations
GROQ_API_KEY=optional_groq_key_for_fast_inference

# Strict Data Provenance Enforcement
ENABLE_SYNTHETIC_FALLBACK=false
